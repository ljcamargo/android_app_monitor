# Google Play Developer Reporting API
# Path to your service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# Your Google Play Developer Account ID (can be found in the Play Console URL)
PLAY_DEVELOPER_ACCOUNT_ID=1234567890123456789

# LLM API
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of package names to monitor
PACKAGE_NAMES=com.example.app1,com.example.app2

# Optional: Local LLM command if not using Gemini
# LOCAL_LLM_COMMAND="ollama run llama3"

# --- AdMob (standalone script: fetch_admob.py) ---
# IMPORTANT: AdMob does NOT support service accounts — user-based OAuth is required.
#
# 1) Create an OAuth client ID (Desktop app) in Cloud Console:
#    APIs & Services > Credentials > Create Credentials > OAuth client ID > Desktop app
#    and download its JSON (or set ADMOB_CLIENT_ID / ADMOB_CLIENT_SECRET below).
#    NOTE: also configure the OAuth consent screen (APIs & Services > OAuth consent screen)
#    and add YOUR OWN email as a test user — see README 'AdMob OAuth Setup'.
# 2) Invite your Google account in apps.admob.com (Settings > Users) and accept the invite.
# 3) Generate a refresh token once:
#    python3 admob_oauth_setup.py --client-json <your_downloaded_client_secret.json>
#    and paste the printed token below (the script does NOT edit .env for you).
ADMOB_CLIENT_CREDENTIALS=admob_oauth_client.json
ADMOB_REFRESH_TOKEN=1//your_refresh_token_here
# Alternative to ADMOB_CLIENT_CREDENTIALS:
# ADMOB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# ADMOB_CLIENT_SECRET=GOCSPX-xxxx
# Publisher ID (optional — auto-discovered if unset): Settings > Account settings
# ADMOB_PUBLISHER_ID=pub-1234567890123456
# Optional: path to JSON mapping app packages to ad unit IDs (see admob_ad_units.example.json)
# ADMOB_AD_UNITS_CONFIG=admob_ad_units.json
# Optional: currency for reports (default USD)
# ADMOB_CURRENCY=USD
# Optional: LLM model override (default gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite
